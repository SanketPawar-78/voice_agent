# --- Server ---
PUBLIC_HOST=your-public-host.example.com
API_KEY=change-me

# --- Who the assistant answers calls for ---
OWNER_NAME=Your Name
ASSISTANT_NAME=Aria

# --- Database ---
DATABASE_URL=postgresql+asyncpg://voice:voice@localhost:5432/voiceagent

# --- Exotel (telephony) ---
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN="api.exotel.com"
EXOTEL_NUMBER=
EXOTEL_FLOW_APP_ID=

# --- Sarvam (STT + TTS, optional LLM) ---
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_LLM_MODEL=sarvam-105b-conversations

# --- LLM: anthropic | sarvam ---
LLM_PROVIDER=sarvam
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- VAD ---
VAD_AGGRESSIVENESS=2
VAD_SILENCE_MS=700
VAD_MIN_SPEECH_MS=200
